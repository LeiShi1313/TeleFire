# OpenAI-compatible chat provider
TELEFIRE_AI_BASE_URL=https://provider.example/v1
TELEFIRE_AI_API_KEY=replace-me
TELEFIRE_AI_CHAT_MODEL=replace-me
TELEFIRE_AI_REASONING_EFFORT=medium
TELEFIRE_AI_MAX_OUTPUT_TOKENS=4000
TELEFIRE_AI_CONTEXT_WINDOW=128000
TELEFIRE_AI_REQUEST_TIMEOUT=90

# Dedicated Pi Agent Engine
TELEFIRE_PI_URL=http://127.0.0.1:8790
TELEFIRE_PI_EXPOSE_PORT=18790
TELEFIRE_PI_RUN_TIMEOUT=300
TELEFIRE_PI_TOKEN=replace-with-a-random-64-character-value

# OpenAI-compatible embeddings; defaults to the chat provider when omitted
# In Docker, use host.docker.internal when Ollama runs on the host.
TELEFIRE_AI_EMBEDDING_BASE_URL=http://ollama-embedding-ollama-1:11434/v1
TELEFIRE_AI_EMBEDDING_API_KEY=ollama
TELEFIRE_AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
TELEFIRE_AI_EMBEDDING_DIMENSION=1024

# Hindsight contextual memory service
TELEFIRE_HINDSIGHT_URL=http://127.0.0.1:18888
TELEFIRE_HINDSIGHT_EXPOSE_PORT=18888
TELEFIRE_HINDSIGHT_UI_EXPOSE_PORT=19999
TELEFIRE_MEMORY_DASHBOARD_EXPOSE_PORT=18866
TELEFIRE_HINDSIGHT_TIMEOUT=90
TELEFIRE_MEMORY_DREAM_LOOKBACK_HOURS=24
TELEFIRE_MEMORY_DREAM_OVERLAP_SECONDS=600
TELEFIRE_MEMORY_DREAM_SETTLEMENT_SECONDS=30
TELEFIRE_MEMORY_DREAM_MAX_MESSAGES=500
TELEFIRE_MEMORY_DREAM_MAX_THREAD_MESSAGES=100
TELEFIRE_MEMORY_DREAM_RETAIN_BATCH_SIZE=10
TELEFIRE_MEMORY_DREAM_CRON=0 * * * *
TELEFIRE_MEMORY_DREAM_CONCURRENCY=2
TELEFIRE_MEMORY_DREAM_SCOPE_BATCH_SIZE=20
TELEFIRE_MEMORY_DREAM_LEASE_SECONDS=3600
TELEFIRE_MEMORY_DREAM_RETRY_ATTEMPTS=3
TELEFIRE_MEMORY_DREAM_MAX_RETRY_DELAY=30

# Telegram AI integration
TELEFIRE_AI_EDIT_CADENCE=4.0
TELEFIRE_AI_DELEGATED_COOLDOWN=30
