# OpenAI-compatible chat provider
TELEFIRE_AI_BASE_URL=https://provider.example/v1
TELEFIRE_AI_API_KEY=replace-me
TELEFIRE_AI_CHAT_MODEL=replace-me
TELEFIRE_AI_REASONING_EFFORT=medium
TELEFIRE_AI_MAX_OUTPUT_TOKENS=4000
TELEFIRE_AI_CONTEXT_WINDOW=128000
TELEFIRE_AI_REQUEST_TIMEOUT=90

# Dedicated Pi Agent Engine
TELEFIRE_PI_URL=http://127.0.0.1:8790
TELEFIRE_PI_EXPOSE_PORT=18790
TELEFIRE_PI_RUN_TIMEOUT=300
TELEFIRE_PI_TOKEN=replace-with-a-random-64-character-value

# OpenAI-compatible embeddings; defaults to the chat provider when omitted
# In Docker, use host.docker.internal when Ollama runs on the host.
TELEFIRE_AI_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
TELEFIRE_AI_EMBEDDING_API_KEY=ollama
TELEFIRE_AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
TELEFIRE_AI_EMBEDDING_DIMENSION=1024

# Standalone memory service and Telegram integration
TELEFIRE_MEMORY_URL=http://127.0.0.1:8765
TELEFIRE_MEMORY_TIMEOUT=90
TELEFIRE_AI_DELEGATED_COOLDOWN=30
TELEFIRE_AI_ALLOWED_CHAT_IDS=-1001234567890
