FROM node:24-bookworm-slim

ENV NODE_ENV=production \
    HOME=/agent-data \
    TELEFIRE_PI_DATA_DIR=/agent-data/.telefire-pi

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        python3 \
        ripgrep \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY agent/package.json agent/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

COPY agent/src ./src

RUN useradd --create-home --home-dir /agent-data --uid 10001 agent \
    && mkdir -p /agent-data/.telefire-pi \
    && chmod a+r package.json package-lock.json \
    && chmod -R a+rX /app/src \
    && chown -R agent:agent /agent-data

USER agent
EXPOSE 8790

CMD ["node", "src/main.mjs"]
