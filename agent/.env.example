# OpenAI-compatible provider used by Pi
AI_BASE_URL=https://provider.example/v1
AI_API_KEY=replace-me
AI_CHAT_MODEL=replace-me
AI_REASONING_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=4000
AI_CONTEXT_WINDOW=128000
AI_REQUEST_TIMEOUT=90

# Shared only with trusted clients of the private Pi HTTP service
PI_AGENT_TOKEN=replace-with-a-random-64-character-value

# Loopback-only published ports
PI_AGENT_EXPOSE_PORT=18790
PLAYGROUND_REQUEST_TIMEOUT=300
PLAYGROUND_SYSTEM_PROMPT=
