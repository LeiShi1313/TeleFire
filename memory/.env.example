# OpenAI-compatible provider used by Hindsight extraction and consolidation
MEMORY_LLM_BASE_URL=https://provider.example/v1
MEMORY_LLM_API_KEY=replace-me
MEMORY_LLM_MODEL=replace-me
MEMORY_LLM_REASONING_EFFORT=low

# OpenAI-compatible embeddings; this example targets the local Ollama stack
MEMORY_EMBEDDING_BASE_URL=http://ollama-embedding-ollama-1:11434/v1
MEMORY_EMBEDDING_API_KEY=ollama
MEMORY_EMBEDDING_MODEL=qwen3-embedding:0.6b
MEMORY_EMBEDDING_DIMENSIONS=1024

# Loopback-only published ports
MEMORY_API_EXPOSE_PORT=18888
MEMORY_UI_EXPOSE_PORT=19999
MEMORY_INSPECTOR_EXPOSE_PORT=18866
MEMORY_API_TIMEOUT=20
